# Copy this file to .env and add your Gemini API key.
GEMINI_API_KEY=AQ.Ab8RN6IUONDYx6lUdBUNFPxvRoSyES6FdIwnHu1dvOrMrbgsAA

# Current Gemini models. You can change these without editing Python code.
GEMINI_WORKOUT_MODEL=gemini-3.8-flash
